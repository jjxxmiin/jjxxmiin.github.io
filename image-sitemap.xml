---
layout: null
sitemap: false
permalink: /image-sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{% for post in site.posts %}
  {% assign hero = post.image.path | default: post.image %}
  {% if hero or post.article_images %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    {% if hero %}
    <image:image>
      <image:loc>{{ hero | absolute_url | xml_escape }}</image:loc>
      <image:title>{{ post.title | strip_html | xml_escape }}</image:title>
      {% if post.image.alt %}<image:caption>{{ post.image.alt | strip_html | xml_escape }}</image:caption>{% endif %}
    </image:image>
    {% endif %}
    {% for item in post.article_images %}
      {% assign image_path = item.path | default: item %}
    <image:image>
      <image:loc>{{ image_path | absolute_url | xml_escape }}</image:loc>
      {% if item.alt %}<image:caption>{{ item.alt | strip_html | xml_escape }}</image:caption>{% endif %}
    </image:image>
    {% endfor %}
  </url>
  {% endif %}
{% endfor %}
</urlset>
