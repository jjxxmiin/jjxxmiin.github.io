---
layout: compress
permalink: /feed.xml
# Atom Feed, reference: https://validator.w3.org/feed/docs/atom.html
#
# 테마(jekyll-theme-chirpy) 원본을 덮어쓴 사본이다. 바꾼 곳은 두 군데.
#   1. limit 5 -> 20. 네이버 서치어드바이저, 다음은 RSS를 주기적으로 읽어
#      새 글을 색인하는데, 하루 2편 발행 체제에서 5편이면 수집 주기가 조금만
#      늦어도 글이 통째로 누락된다.
#   2. 태그를 category term으로 함께 내보낸다. 수집기가 주제를 파악하는 데 쓰인다.
# 테마를 업그레이드할 때 원본이 바뀌었는지 확인할 것.
---

{% capture source %}
<feed xmlns="http://www.w3.org/2005/Atom">
  <id>{{ "/" | absolute_url }}</id>
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | strip_newlines | strip | xml_escape }}</subtitle>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.author.name | default: site.social.name | xml_escape }}</name>
    <uri>{{ "/" | absolute_url }}</uri>
  </author>
  <link rel="self" type="application/atom+xml" href="{{ page.url | absolute_url }}"/>
  <link rel="alternate" type="text/html" hreflang="{{ site.alt_lang | default: site.lang }}"
    href="{{ '/' | absolute_url }}"/>
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <rights>© {{ 'now' | date: '%Y' }} {{ site.title | xml_escape }}</rights>
  <icon>{{ '/assets/img/favicons/favicon.ico' | absolute_url }}</icon>
  <logo>{{ '/assets/img/favicons/favicon-96x96.png' | absolute_url }}</logo>

{% for post in site.posts limit: 20 %}
  {% assign post_absolute_url = post.url | absolute_url %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post_absolute_url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
  {% if post.last_modified_at %}
    <updated>{{ post.last_modified_at | date_to_xmlschema }}</updated>
  {% else %}
    <updated>{{ post.date | date_to_xmlschema }}</updated>
  {% endif %}
    <id>{{ post_absolute_url }}</id>
    <content type="text/html" src="{{ post_absolute_url }}" />
    <author>
      <name>{{ post.author.name | default: post.author | default: site.author.name | default: site.social.name | xml_escape }}</name>
    </author>

  {% if post.categories %}
    {% for category in post.categories %}
    <category term="{{ category | xml_escape }}" />
    {% endfor %}
  {% endif %}
  {% if post.tags %}
    {% for tag in post.tags %}
    <category term="{{ tag | xml_escape }}" />
    {% endfor %}
  {% endif %}

  <summary>{{ post.description | default: post.summary | default: post.excerpt | strip_html | strip_newlines | strip | truncate: 400 | xml_escape }}</summary>

  </entry>
{% endfor %}
</feed>
{% endcapture %}
{{ source }}
