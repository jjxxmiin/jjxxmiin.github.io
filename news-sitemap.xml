---
layout: null
permalink: /news-sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:news="http://www.google.com/schemas/sitemap-news/0.9"
>
{%- assign build_epoch = site.time | date: '%s' | plus: 0 -%}
{%- assign news_cutoff = build_epoch | minus: 172800 -%}
{%- for post in site.posts -%}
  {%- assign post_epoch = post.date | date: '%s' | plus: 0 -%}
  {%- if post.seo.type == 'NewsArticle' and post_epoch >= news_cutoff -%}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    <news:news>
      <news:publication>
        <news:name>{{ site.title | xml_escape }}</news:name>
        <news:language>ko</news:language>
      </news:publication>
      <news:publication_date>{{ post.date | date_to_xmlschema }}</news:publication_date>
      <news:title>{{ post.title | strip_html | xml_escape }}</news:title>
    </news:news>
  </url>
  {%- endif -%}
{%- endfor -%}
</urlset>
